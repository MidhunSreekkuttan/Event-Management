{
    "$schema": "https://openapi.vercel.sh/vercel.json",
    "services": {
        "admin": {
            "root": "admin",
            "framework": "vite"
        },
        "backend": {
            "root": "backend",
            "framework": "express"
        },
        "frontend": {
            "root": "frontend",
            "framework": "vite"
        },
        "staff": {
            "root": "staff",
            "framework": "vite"
        }
    },
    "rewrites": [
        {
            "source": "/admin/(.*)",
            "destination": {
                "service": "admin"
            }
        },
        {
            "source": "/api/(.*)",
            "destination": {
                "service": "backend"
            }
        },
        {
            "source": "/app/(.*)",
            "destination": {
                "service": "frontend"
            }
        }
    ]
}