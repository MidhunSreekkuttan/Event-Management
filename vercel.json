{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "backend": {
      "root": "backend",
      "framework": "express",
      "entrypoint": "server.js"
    },
    "admin": {
      "root": "admin",
      "framework": "vite"
    },
    "staff": {
      "root": "staff",
      "framework": "vite"
    },
    "frontend": {
      "root": "frontend",
      "framework": "vite"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "backend"
      }
    },
    {
      "source": "/uploads/(.*)",
      "destination": {
        "service": "backend"
      }
    },
    {
      "source": "/admin/assets/(.*)",
      "destination": {
        "service": "admin"
      }
    },
    {
      "source": "/admin",
      "destination": {
        "service": "admin",
        "path": "/admin/index.html"
      }
    },
    {
      "source": "/admin/(.*)",
      "destination": {
        "service": "admin",
        "path": "/admin/index.html"
      }
    },
    {
      "source": "/staff/assets/(.*)",
      "destination": {
        "service": "staff"
      }
    },
    {
      "source": "/staff/(.*\\.(?:gif|avif|png|jpg|jpeg|svg|ico|webp))",
      "destination": {
        "service": "staff"
      }
    },
    {
      "source": "/staff",
      "destination": {
        "service": "staff",
        "path": "/staff/index.html"
      }
    },
    {
      "source": "/staff/(.*)",
      "destination": {
        "service": "staff",
        "path": "/staff/index.html"
      }
    },
    {
      "source": "/assets/(.*)",
      "destination": {
        "service": "frontend"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "frontend",
        "path": "/index.html"
      }
    }
  ]
}
