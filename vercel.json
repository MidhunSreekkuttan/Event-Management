{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "backend": {
      "root": "backend",
      "framework": "express",
      "entrypoint": "server.js"
    },
    "admin": {
      "root": "admin",
      "framework": "vite"
    },
    "staff": {
      "root": "staff",
      "framework": "vite"
    },
    "frontend": {
      "root": "frontend",
      "framework": "vite"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "backend",
        "path": "/api/$1"
      }
    },
    {
      "source": "/uploads/(.*)",
      "destination": {
        "service": "backend",
        "path": "/uploads/$1"
      }
    },
    {
      "source": "/admin",
      "destination": {
        "service": "admin",
        "path": "/"
      }
    },
    {
      "source": "/admin/(.*)",
      "destination": {
        "service": "admin",
        "path": "/$1"
      }
    },
    {
      "source": "/staff",
      "destination": {
        "service": "staff",
        "path": "/"
      }
    },
    {
      "source": "/staff/(.*)",
      "destination": {
        "service": "staff",
        "path": "/$1"
      }
    },
    {
      "source": "/app",
      "destination": {
        "service": "frontend",
        "path": "/"
      }
    },
    {
      "source": "/app/(.*)",
      "destination": {
        "service": "frontend",
        "path": "/$1"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "frontend",
        "path": "/$1"
      }
    }
  ]
}
