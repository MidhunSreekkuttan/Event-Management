{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "backend": {
      "root": "backend",
      "framework": "express",
      "entrypoint": "server.js"
    },
    "frontend": {
      "root": "frontend",
      "framework": "vite",
      "rewrites": [
        {
          "source": "/app",
          "destination": "/"
        },
        {
          "source": "/app/(.*)",
          "destination": "/$1"
        },
        {
          "source": "/(.*)",
          "destination": "/index.html"
        }
      ]
    },
    "admin": {
      "root": "admin",
      "framework": "vite",
      "rewrites": [
        {
          "source": "/admin",
          "destination": "/"
        },
        {
          "source": "/admin/(.*)",
          "destination": "/$1"
        },
        {
          "source": "/(.*)",
          "destination": "/index.html"
        }
      ]
    },
    "staff": {
      "root": "staff",
      "framework": "vite",
      "rewrites": [
        {
          "source": "/staff",
          "destination": "/"
        },
        {
          "source": "/staff/(.*)",
          "destination": "/$1"
        },
        {
          "source": "/(.*)",
          "destination": "/index.html"
        }
      ]
    }
  },
  "redirects": [
    {
      "source": "/",
      "destination": "/app/",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "backend"
      }
    },
    {
      "source": "/uploads/(.*)",
      "destination": {
        "service": "backend"
      }
    },
    {
      "source": "/app",
      "destination": {
        "service": "frontend",
        "path": "/"
      }
    },
    {
      "source": "/app/(.*)",
      "destination": {
        "service": "frontend",
        "path": "/$1"
      }
    },
    {
      "source": "/admin",
      "destination": {
        "service": "admin",
        "path": "/"
      }
    },
    {
      "source": "/admin/(.*)",
      "destination": {
        "service": "admin",
        "path": "/$1"
      }
    },
    {
      "source": "/staff",
      "destination": {
        "service": "staff",
        "path": "/"
      }
    },
    {
      "source": "/staff/(.*)",
      "destination": {
        "service": "staff",
        "path": "/$1"
      }
    }
  ]
}